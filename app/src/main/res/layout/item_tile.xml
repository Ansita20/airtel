<?xml version="1.0" encoding="utf-8"?>
<!-- A chunky tap tile: big emoji or letter on top, 1–3 words below. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tile"
    android:clickable="true"
    android:focusable="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:minHeight="@dimen/tile_min_height"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="14dp"
    android:paddingEnd="10dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/option_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/option_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/tile_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/option_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/tile_hint"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>

    <!-- Tick on chosen tiles, so "pick many" screens clearly show every choice. -->
    <TextView
        android:id="@+id/option_check"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/bg_check"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text="✓"
        android:textColor="@color/tile_fill"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
