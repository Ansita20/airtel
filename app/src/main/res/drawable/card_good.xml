<?xml version="1.0" encoding="utf-8"?>
<!-- Chunky tap card: a darker bottom edge that disappears when pressed, so the card "sinks". -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/good_face" />
                    
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/good_edge" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/good_face" />
                    
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
